<li data-section-id=3D"1bxj043" data-start=3D"1861" data-end=3D"1870">
<p data-start=3D"1863" data-end=3D"1870">Android</p>
</li>
<li data-section-id=3D"1o3epp" data-start=3D"1871" data-end=3D"1876">
<p data-start=3D"1873" data-end=3D"1876">iOS</p>
</li>
<li data-section-id=3D"1o4v4o" data-start=3D"1877" data-end=3D"1882">
<p data-start=3D"1879" data-end=3D"1882">Web</p>
