<p data-start=3D"1961" data-end=3D"1968"><strong data-start=3D"1961" data-e=
nd=3D"1968">iOS</strong></p>
<ul data-start=3D"1969" data-end=3D"1996">
<li data-section-id=3D"16yg7v1" data-start=3D"1969" data-end=3D"1976">
